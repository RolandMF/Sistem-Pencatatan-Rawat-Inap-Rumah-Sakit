-- U1: Update status kamar setelah pasien keluar
UPDATE kamar
SET    status = 'Kosong'
WHERE  id_kamar NOT IN (
    SELECT DISTINCT id_kamar
    FROM   rawat_inap
    WHERE  status = 'Aktif'
);

