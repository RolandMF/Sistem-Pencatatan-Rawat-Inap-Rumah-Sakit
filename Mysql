-- ============================================================
--  DML — SELECT (Query Operasional)
-- ============================================================

-- ─── Q1: Daftar semua pasien yang sedang aktif dirawat ────
SELECT
    p.no_rm,
    p.nama_pasien,
    d.nama_dokter,
    d.spesialisasi,
    k.nomor_kamar,
    k.kelas,
    ri.tanggal_masuk,
    ri.diagnosis
FROM rawat_inap ri
JOIN pasien p ON ri.id_pasien = p.id_pasien
JOIN dokter  d ON ri.id_dokter = d.id_dokter
JOIN kamar   k ON ri.id_kamar  = k.id_kamar
WHERE ri.status = 'Aktif'
ORDER BY ri.tanggal_masuk;

-- ─── Q2: Estimasi total biaya kamar per pasien ────────────
--        (COALESCE agar pasien aktif dihitung sampai hari ini)
SELECT
    p.nama_pasien,
    k.nomor_kamar,
    k.kelas,
    ri.tanggal_masuk,
    COALESCE(ri.tanggal_keluar, CURDATE())                              AS tanggal_keluar,
    DATEDIFF(COALESCE(ri.tanggal_keluar, CURDATE()), ri.tanggal_masuk) AS lama_hari,
    k.harga_per_hari,
    DATEDIFF(COALESCE(ri.tanggal_keluar, CURDATE()), ri.tanggal_masuk)
        * k.harga_per_hari                                              AS total_biaya_kamar
FROM rawat_inap ri
JOIN pasien p ON ri.id_pasien = p.id_pasien
JOIN kamar  k ON ri.id_kamar  = k.id_kamar
ORDER BY total_biaya_kamar DESC;

-- ─── Q3: Detail resep tiap pasien beserta total harga obat ─
SELECT
    p.nama_pasien,
    ri.diagnosis,
    o.nama_obat,
    r.jumlah,
    o.satuan,
    r.keterangan,
    r.jumlah * o.harga AS total_harga_obat
FROM resep r
JOIN rawat_inap ri ON r.id_rawat_inap = ri.id_rawat_inap
JOIN pasien     p  ON ri.id_pasien    = p.id_pasien
JOIN obat       o  ON r.id_obat       = o.id_obat
ORDER BY p.nama_pasien, o.nama_obat;

-- ─── Q4: Jumlah pasien yang ditangani tiap dokter ─────────
SELECT
    d.nama_dokter,
    d.spesialisasi,
    COUNT(ri.id_rawat_inap) AS total_pasien
FROM dokter d
LEFT JOIN rawat_inap ri ON d.id_dokter = ri.id_dokter
GROUP BY d.id_dokter, d.nama_dokter, d.spesialisasi
ORDER BY total_pasien DESC;

-- ─── Q5: Kamar yang masih tersedia ───────────────────────
SELECT
    nomor_kamar,
    kelas,
    FORMAT(harga_per_hari, 0) AS harga_per_hari
FROM kamar
WHERE status = 'Tersedia'
ORDER BY kelas, nomor_kamar;
