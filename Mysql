-- ─────────────────────────────────────────────
--  DATABASE
-- ─────────────────────────────────────────────
CREATE DATABASE IF NOT EXISTS db_rawat_inap;
USE db_rawat_inap;


-- ============================================================
--  DDL — CREATE TABLE
-- ============================================================

-- 1. Tabel PASIEN
CREATE TABLE pasien (
    id_pasien       INT             AUTO_INCREMENT PRIMARY KEY,
    no_rm           VARCHAR(10)     NOT NULL UNIQUE,           -- Nomor Rekam Medis
    nama_pasien     VARCHAR(100)    NOT NULL,
    tanggal_lahir   DATE            NOT NULL,
    jenis_kelamin   ENUM('L','P')   NOT NULL,
    alamat          TEXT,
    no_telepon      VARCHAR(15)
);

-- 2. Tabel DOKTER
CREATE TABLE dokter (
    id_dokter       INT             AUTO_INCREMENT PRIMARY KEY,
    nama_dokter     VARCHAR(100)    NOT NULL,
    spesialisasi    VARCHAR(50)     NOT NULL,
    no_telepon      VARCHAR(15)
);

-- 3. Tabel KAMAR
CREATE TABLE kamar (
    id_kamar        INT                         AUTO_INCREMENT PRIMARY KEY,
    nomor_kamar     VARCHAR(10)                 NOT NULL UNIQUE,
    kelas           ENUM('VIP','I','II','III')   NOT NULL,
    harga_per_hari  DECIMAL(10,2)               NOT NULL,
    status          ENUM('Tersedia','Terisi')    NOT NULL DEFAULT 'Tersedia'
);

-- 4. Tabel RAWAT_INAP  (tabel utama — penghubung pasien, dokter, kamar)
CREATE TABLE rawat_inap (
    id_rawat_inap   INT             AUTO_INCREMENT PRIMARY KEY,
    id_pasien       INT             NOT NULL,
    id_dokter       INT             NOT NULL,
    id_kamar        INT             NOT NULL,
    tanggal_masuk   DATE            NOT NULL,
    tanggal_keluar  DATE,                                      -- NULL = masih dirawat
    diagnosis       VARCHAR(255),
    status          ENUM('Aktif','Selesai') NOT NULL DEFAULT 'Aktif',
    FOREIGN KEY (id_pasien)  REFERENCES pasien(id_pasien),
    FOREIGN KEY (id_dokter)  REFERENCES dokter(id_dokter),
    FOREIGN KEY (id_kamar)   REFERENCES kamar(id_kamar)
);

-- 5. Tabel OBAT
CREATE TABLE obat (
    id_obat         INT             AUTO_INCREMENT PRIMARY KEY,
    nama_obat       VARCHAR(100)    NOT NULL,
    satuan          VARCHAR(20)     NOT NULL,
    harga           DECIMAL(10,2)   NOT NULL
);

-- 6. Tabel RESEP  (obat yang diberikan per episode rawat inap)
CREATE TABLE resep (
    id_resep        INT             AUTO_INCREMENT PRIMARY KEY,
    id_rawat_inap   INT             NOT NULL,
    id_obat         INT             NOT NULL,
    jumlah          INT             NOT NULL,
    keterangan      VARCHAR(255),
    FOREIGN KEY (id_rawat_inap) REFERENCES rawat_inap(id_rawat_inap),
    FOREIGN KEY (id_obat)       REFERENCES obat(id_obat)
);


