-- ============================================================
-- [3] QUERY SELECT - LAPORAN & MONITORING
-- ============================================================

-- Q1: Daftar seluruh pasien rawat inap yang AKTIF
SELECT
    ri.id_rawat_inap,
    p.nama_pasien,
    d.nama_dokter,
    d.spesialisasi,
    k.nomor_kamar,
    k.kelas,
    ri.tanggal_masuk,
    ri.diagnosis
FROM rawat_inap ri
JOIN pasien p ON ri.id_pasien = p.id_pasien
JOIN dokter d ON ri.id_dokter = d.id_dokter
JOIN kamar  k ON ri.id_kamar  = k.id_kamar
WHERE ri.status = 'Aktif'
ORDER BY ri.tanggal_masuk;

-- Q2: Detail resep obat lengkap (resep + daftar obat + apoteker)
SELECT
    ro.id_resep,
    ro.tanggal_resep,
    p.nama_pasien,
    d.nama_dokter,
    ap.nama_apoteker,
    o.nama_obat,
    o.satuan,
    dro.jumlah,
    (dro.jumlah * o.harga) AS subtotal_obat,
    ro.keterangan
FROM resep_obat ro
JOIN rawat_inap        ri  ON ro.id_rawat_inap = ri.id_rawat_inap
JOIN pasien            p   ON ri.id_pasien     = p.id_pasien
JOIN dokter            d   ON ro.id_dokter     = d.id_dokter
JOIN apoteker          ap  ON ro.id_apoteker   = ap.id_apoteker
JOIN detail_resep_obat dro ON ro.id_resep      = dro.id_resep
JOIN obat              o   ON dro.id_obat      = o.id_obat
ORDER BY ro.id_resep, o.nama_obat;

-- Q3: Monitoring tarif kamar per hari pasien rawat inap
SELECT
    p.nama_pasien,
    ri.id_rawat_inap,
    k.harga_per_hari
FROM rawat_inap ri
JOIN pasien               p   ON ri.id_pasien   = p.id_pasien
JOIN kamar                k   ON ri.id_kamar    = k.id_kamar
LEFT JOIN resep_obat        ro  ON ri.id_rawat_inap = ro.id_rawat_inap
LEFT JOIN detail_resep_obat dro ON ro.id_resep  = dro.id_resep
LEFT JOIN obat              o   ON dro.id_obat    = o.id_obat
GROUP BY p.nama_pasien, ri.id_rawat_inap, k.harga_per_hari;

-- Q4: Perawat yang bertugas per pasien rawat inap
SELECT
    ri.id_rawat_inap,
    p.nama_pasien,
    GROUP_CONCAT(pw.nama_perawat
               ORDER BY pw.nama_perawat SEPARATOR ', ') AS daftar_perawat,
    GROUP_CONCAT(pw.shift
               ORDER BY pw.nama_perawat SEPARATOR ', ') AS shift_perawat
FROM rawat_inap ri
JOIN pasien             p   ON ri.id_pasien    = p.id_pasien
JOIN perawat_rawat_inap pri ON ri.id_rawat_inap = pri.id_rawat_inap
JOIN perawat            pw  ON pri.id_perawat  = pw.id_perawat
GROUP BY ri.id_rawat_inap;


